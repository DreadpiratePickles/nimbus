  {"id": "requested-region-deny", "provenance": "authored, not recorded live",
   "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_aws_deny-requested-region.html",
   "CallerArn": "arn:aws:iam::111122223333:role/builder", "ResourceOwner": "111122223333",
   "PolicyInputList": [
     {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": "ec2:*", "Resource": "*"}]},
     {"Version": "2012-10-17", "Statement": [{"Sid": "DenyAllOutsideRequestedRegions", "Effect": "Deny", "NotAction": ["iam:*", "sts:*"], "Resource": "*", "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["eu-central-1", "eu-west-1"]}}}]}],
   "ContextEntries": [{"ContextKeyName": "aws:RequestedRegion", "ContextKeyValues": ["us-east-1"], "ContextKeyType": "string"}],
   "EvaluationResults": [
