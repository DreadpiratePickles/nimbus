{
  "Provider": "aws",
  "CheckID": "s3_bucket_secure_transport_policy",
  "CheckTitle": "Ensure S3 Bucket Policy is set to deny HTTP requests",
  "CheckType": [
    "Software and Configuration Checks/Industry and Regulatory Standards/CIS AWS Foundations Benchmark"
  ],
  "ServiceName": "s3",
  "SubServiceName": "",
  "ResourceIdTemplate": "arn:partition:s3:::bucket-name",
  "Severity": "medium",
  "ResourceType": "AwsS3Bucket",
  "Description": "Checks that each bucket policy denies requests that are not sent over TLS (aws:SecureTransport = false).",
  "Risk": "Without an explicit deny, clients may read or write objects over unencrypted HTTP, exposing data and credentials in transit.",
  "RelatedUrl": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/security-best-practices.html",
  "Remediation": {
    "Code": {
      "CLI": "",
      "NativeIaC": "",
      "Other": "{\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:*\",\"Resource\":[\"arn:aws:s3:::<bucket>\",\"arn:aws:s3:::<bucket>/*\"],\"Condition\":{\"Bool\":{\"aws:SecureTransport\":\"false\"}}}",
      "Terraform": ""
    },
    "Recommendation": {
      "Text": "Add a bucket policy statement that denies s3:* when aws:SecureTransport is false.",
      "Url": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/security-best-practices.html"
    }
  },
  "Categories": [
    "encryption"
  ],
