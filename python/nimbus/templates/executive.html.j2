<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Multi-framework executive summary</title>
<style>
:root{--root:#2b1d14;--root-2:#3a281b;--win:#efe4cf;--win-2:#e4d6bc;--ink:#2a1a10;--ink-2:#5a4330;--muted:#8a7058;--focus:#c9a87a;--idle:#6b4e36;--line:#cdb995;--good:#5f7a2a;--warning:#b8860b;--serious:#c4621d;--critical:#a8321e;--na:#a8957a;--accent:#4f6d8a;--mono:Spleen,Terminus,"Terminus (TTF)",fixed,ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
body{margin:0;color:var(--ink);font:13px/1.5 var(--mono);background:var(--root) repeating-conic-gradient(var(--root) 0 25%,var(--root-2) 0 50%) 0 0/4px 4px}
main{max-width:1080px;margin:16px auto;padding:20px;background:var(--win);border:1px solid var(--idle)}h1{font-size:20px;margin:0 0 4px}.sub{color:var(--ink-2)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:20px}
.card{background:var(--win);border:1px solid var(--line);padding:14px;text-align:center;break-inside:avoid}
.card h3{margin:4px 0 0;font-size:15px}.card p{margin:4px 0;color:var(--ink-2);font-size:12px}
.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;background:var(--win);margin-top:24px}
th,td{text-align:left;padding:7px 9px;border-bottom:1px solid var(--line);font-size:13px}th{font-size:12px;color:var(--ink-2);text-transform:uppercase}
@media print{body{background:#fff}main{margin:0;padding:0;border:0;background:#fff}}
</style></head>
<body><main>
<h1>Compliance executive summary</h1>
<div class="sub">Generated {{ generated_at }} · {{ reports|length }} frameworks · {{ findings_total }} findings evaluated</div>
<div class="cards">
{% for item in reports %}<div class="card">{{ item.gauge | safe }}<h3>{{ item.r.framework.name }}</h3>
<p>{{ item.r.passing }} passing · {{ item.r.failing }} failing · {{ item.r.not_assessed }} not assessed</p></div>{% endfor %}
</div>
<div class="table-wrap"><table><thead><tr><th>Framework</th><th>Score</th><th>Failing controls</th><th>Top remediation</th></tr></thead><tbody>
{% for item in reports %}<tr><td>{{ item.r.framework.name }}</td><td>{{ item.r.score_percent }}%</td><td>{{ item.r.failing }}</td>
<td>{% if item.r.roadmap %}<code>{{ item.r.roadmap[0].canonical_id }}</code> ({{ item.r.roadmap[0].count }} resources){% else %}-{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
</main></body></html>
